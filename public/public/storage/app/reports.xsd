<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="report">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="subject" type="xs:string" maxLength="255" />
        <xs:element name="content" type="xs:string" />
        <xs:element name="employee_id" type="xs:integer" />
        <xs:element name="photo" type="xs:string" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
