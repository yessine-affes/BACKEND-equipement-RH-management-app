<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="taskAssignment">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="task_id" type="xs:integer" />
        <xs:element name="employee_id" type="xs:integer" />
        <xs:element name="equipment_id" type="xs:integer" minOccurs="0" />
        <xs:element name="assigned_date" type="xs:date" />
        <xs:element name="completion_date" type="xs:date" minOccurs="0" />
        <xs:element name="status" type="xs:string" maxLength="50" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
